{
  "name": "ai-mail-assistant",
  "private": true,
  "version": "0.1.0",
  "description": "AI Email Assistant SaaS - monorepo (client + server)",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev:worker": "npm run dev:worker --workspace=server",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "lint": "npm run lint --workspace=server && npm run lint --workspace=client",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore",
    "test": "npm run test --workspace=server",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "lint-staged": {
    "server/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "client/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
