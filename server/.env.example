# --- App ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000

# --- Database ---
MONGO_URI=mongodb://localhost:27017/ai-mail-assistant

# --- Redis (BullMQ + rate limiting) ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
JWT_ACCESS_SECRET=replace_with_openssl_rand_base64_32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_openssl_rand_base64_32
JWT_REFRESH_EXPIRES_IN=7d

# --- Encryption (AES-256-GCM key for OAuth tokens at rest) ---
ENCRYPTION_KEY=replace_with_openssl_rand_base64_32

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

# --- Gemini ---
# Free API key, no billing/credit card required: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- RAG / Vector Search ---
# Only set to true once you've run `npx tsx scripts/create-vector-index.ts`
# against an actual MongoDB Atlas cluster (M10+, or Atlas Search-enabled
# Flex/Serverless) — local/community MongoDB cannot run $vectorSearch at
# all, so this must stay false for local Docker-based dev. See
# docs/RAG_AND_DASHBOARDS.md.
MONGO_ATLAS_VECTOR_SEARCH_ENABLED=false

# --- Worker ---
WORKER_CONCURRENCY=5
